---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlagshipScene from '../../components/FlagshipScene.astro';
import AureviaArt from '../../components/AureviaArt.astro';
import {
  brands,
  getPlansByBrand,
  getQualityByBrand,
  getLineByBrand,
  getPolicyByBrand,
  getIpEvidenceByBrand,
} from '../../lib/data';

export function getStaticPaths() {
  return brands.map((b) => ({
    params: { brand: b.id },
    props: { brand: b },
  }));
}

const { brand } = Astro.props;
const brandPlans = getPlansByBrand(brand.id);
const quality = getQualityByBrand(brand.id);
const lineInfo = getLineByBrand(brand.id);
const policy = getPolicyByBrand(brand.id);
const ipInfo = getIpEvidenceByBrand(brand.id);

const thirtyItems = [
  ['01. 品牌名称', `${brand.name}（${brand.nameEn}）`],
  ['02. 品牌标识与简称', `文字标识：${brand.shortName}（别名：${brand.aliases?.join('、') || '无'}）`],
  ['03. 品牌服务定位', brand.tagline],
  ['04. 品牌原创介绍', brand.summary],
  ['05. 运营历史及公开记录', `资料收录日期：${brand.verifiedAt || '2026-11-25'}；暂缺独立可核验的成立年份审计档案，不虚构运营年限。`],
  ['06. 完整套餐价格', `已收录 ${brandPlans.length} 条历史套餐记录（详见下方完整价格表）。`],
  ['07. 整期实际付款金额', brandPlans.length > 0 ? `最低历史记录 ¥${Math.min(...brandPlans.map((p) => p.price))}，具体以结算页为准。` : '暂无记录'],
  ['08. 高端套餐及服务权益', brand.otherServices?.join('；') || '以高流量周期套餐与专线节点描述为主，未见单独独立 SLA 声明。'],
  ['09. 流量额度与计费倍率', brand.ratio || '未明确标注'],
  ['10. 流量重置及有效期', brand.trafficRules?.join('；') || '常规按月重置，未用完不结转。'],
  ['11. 网络线路架构', brand.lineTypes?.join('；') || '未见明确公开架构说明'],
  ['12. IEPL 及 IPLC 线路证据', lineInfo?.hasIeplClaim || lineInfo?.hasIplcClaim ? `服务商宣传提及：${lineInfo.declaredLineTypes.join('、')}；独立核验状态：${lineInfo.independentVerificationStatus}` : '未见明确 IEPL/IPLC 宣传，亦无独立核验证据'],
  ['13. BGP 及其他中转线路资料', lineInfo?.hasBgpClaim ? '公开资料提及 BGP 调度；尚未取得独立路由追踪审计。' : '未单独标注 BGP 中转细节'],
  ['14. 全球节点地区覆盖', brand.regions?.join('、') || '未完整列出'],
  ['15. 原生 IP、住宅 IP 资料', ipInfo?.ipTypeStatus || '未见明确原生或住宅 IP 公开承诺'],
  ['16. 实际带宽及传输速度证据', '暂无独立多日实测样本；不将单次测速或“不限速”宣传视为无限带宽保证。'],
  ['17. 网络延迟证据', '暂无独立跨运营商晚高峰延迟统计样本。'],
  ['18. 丢包及抖动证据', '暂无独立 MTR 多日丢包与抖动采样数据。'],
  ['19. 晚高峰性能资料', '尚待独立实测站（jichangshice.mom）规范采样，当前不虚构晚高峰数值。'],
  ['20. 服务连续性及维护记录', '暂无独立第三方长期在线率监控记录，建议优先月付观察。'],
  ['21. AI 应用兼容性', brand.aiTools?.length ? `公开提及：${brand.aiTools.join('、')}（${brand.streamingNote || '不作持续可用保证'}）` : '未单独列出 AI 兼容声明'],
  ['22. 流媒体兼容性', brand.streaming?.length ? `公开提及：${brand.streaming.join('、')}（${brand.streamingNote || '历史记录不作长期保证'}）` : '未单独列出流媒体兼容声明'],
  ['23. 商务办公适用条件', '属于消费级个人代理服务，不具备企业级 SLA 与合规审计；重要商务建议配备备用方案。'],
  ['24. 设备及客户端支持', `并发限制：${brand.deviceLimit || '未明示'}；客户端政策：${brand.clientPolicy?.join('；') || '以官网说明为准'}`],
  ['25. 第三方订阅政策', brand.clientPolicy?.find((c) => /订阅|Clash|Mihomo/i.test(c)) || '购买前请向官方客服确认最新第三方客户端订阅政策。'],
  ['26. 客服与售后服务', policy?.supportChannels?.join('、') || '未见详细客服渠道公开说明'],
  ['27. 试用、退款及升级政策', `试用：${policy?.trialPolicy || '未明示'}；退款：${policy?.refundPolicy || '未明示'}`],
  ['28. 原始优惠码及推广链接', `原始优惠码：${brand.coupon?.code || '无'}（${brand.coupon?.discount || '以结算页为准'}）`],
  ['29. 隐私政策、安全及消费风险', '消费级服务普遍未经过第三方无日志审计；请勿从非官方渠道下载客户端或直接大额年付。'],
  ['30. 资料来源、核验日期及评价结论', `来源：18家品牌资料总索引（2026-11-25）；完整度：${quality?.evidenceCompleteness ?? 0}%；结论：${quality?.tierLabel || '已收录'}（暂不评分）。`],
];
---
<BaseLayout
  title={`${brand.name}（${brand.nameEn}）｜30项品牌资料档案、套餐价格与优惠码 - 顶级机场`}
  description={`${brand.name}完整30项专业资料档案：包含${brandPlans.length}条历史套餐价格、优惠码 ${brand.coupon?.code || ''}、线路声明边界、设备限制与客观优缺点分析。`}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '全部机场品牌', url: '/airports/' },
    { name: brand.name, url: `/airports/${brand.id}/` },
  ]}
>
  <section class="scene-band scene-platinum">
    <FlagshipScene scene="collection" />
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:2rem;">
        <div>
          <span class="chapter-badge">Brand Dossier #{String(brand.order).padStart(2, '0')} · 30项档案</span>
          <h1 class="section-title" style="font-size:clamp(1.85rem,3vw,2.55rem);">
            {brand.name} · {brand.nameEn}
          </h1>
          <p class="section-lead">{brand.tagline}</p>

          <div style="display:flex;flex-wrap:wrap;gap:0.65rem;margin-bottom:1rem;">
            <a
              href={brand.affiliateUrl}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="btn-imperial btn-primary-gold"
            >
              前往 {brand.name} 官网入口（推广链接）↗
            </a>
            <button
              type="button"
              id="fav-brand-btn"
              data-brand-id={brand.id}
              class="btn-imperial btn-secondary-platinum"
            >
              收藏至我的皇家档案
            </button>
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            <span class="evidence-pill">资料完整度：{quality?.evidenceCompleteness ?? 0}%</span>
            <span class="evidence-pill warn">{quality?.tierLabel || '已收录'}（暂不评分）</span>
            {brand.coupon?.code && (
              <span class="evidence-pill">原始优惠码：{brand.coupon.code}</span>
            )}
          </div>
        </div>
        <div style="max-width:320px;margin:0 auto;">
          <AureviaArt pose="plans" compact />
        </div>
      </div>
    </div>
  </section>

  <section class="scene-band scene-champagne">
    <div class="container">
      <div class="grid-2" style="margin-bottom:2rem;">
        <div class="imperial-card">
          <h2 style="margin:0 0 0.6rem;font-size:1.15rem;">公开资料反映的优势特征</h2>
          <ul style="margin:0;padding-left:1.2rem;display:grid;gap:0.4rem;font-size:0.92rem;">
            <li>已公开 {brandPlans.length} 条历史多周期套餐记录，定价档位透明。</li>
            <li>{brand.ratio || '具备明确计费倍率说明'}；设备政策：{brand.deviceLimit || '见条款'}。</li>
            {brand.regions && <li>公开声明覆盖 {brand.regions.join('、')} 等地区节点。</li>}
          </ul>
        </div>
        <div class="imperial-card">
          <h2 style="margin:0 0 0.6rem;font-size:1.15rem;">证据不足与消费注意（客观不足）</h2>
          <ul style="margin:0;padding-left:1.2rem;display:grid;gap:0.4rem;font-size:0.92rem;">
            <li>目前尚无独立多日晚高峰带宽、延迟与丢包率实测采样数据。</li>
            <li>公开线路声明（{brand.lineTypes?.join('、') || '常规线路'}）尚缺独立 ASN 物理链路验证。</li>
            <li>{brand.streamingNote || '流媒体与 AI 工具可用性不作长期保证，优惠码有效期请以结算页为准。'}</li>
          </ul>
        </div>
      </div>

      <h2 class="section-title">30 项专业资料完整档案</h2>
      <div class="table-scroll" style="margin-bottom:2.5rem;">
        <table class="imperial-table">
          <thead>
            <tr>
              <th style="width:260px;">档案项目</th>
              <th>核验内容与证据边界</th>
            </tr>
          </thead>
          <tbody>
            {thirtyItems.map(([label, val]) => (
              <tr>
                <td><strong>{label}</strong></td>
                <td>{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="section-title">历史套餐价格记录（共 {brandPlans.length} 条）</h2>
      <p style="font-size:0.86rem;color:var(--text-muted);margin:0 0 1rem;">
        以下均为公开历史检索价格（标注采集来源与核验日期），不代表当前实时结算价。
      </p>
      <div class="table-scroll">
        <table class="imperial-table">
          <thead>
            <tr>
              <th>套餐名称</th>
              <th>计费周期</th>
              <th>整期历史售价</th>
              <th>折合每月</th>
              <th>流量额度</th>
              <th>每 GB 约价</th>
              <th>核验日期</th>
            </tr>
          </thead>
          <tbody>
            {brandPlans.map((p) => (
              <tr>
                <td><strong>{p.planName}</strong></td>
                <td>{p.cycle}</td>
                <td><strong>¥{p.price}</strong></td>
                <td>{p.monthlyEquivalent ? `¥${p.monthlyEquivalent}` : '-'}</td>
                <td>{p.trafficGb ? `${p.trafficGb} GB` : '-'}</td>
                <td>{p.pricePerGb ? `¥${p.pricePerGb}` : '-'}</td>
                <td>{p.verifiedAt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('fav-brand-btn');
      if (!btn) return;
      var brandId = btn.getAttribute('data-brand-id');
      var key = 'imperial_prestige_profile_v1';
      function getProf() {
        try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { return {}; }
      }
      function sync() {
        var p = getProf();
        var list = Array.isArray(p.favoriteBrands) ? p.favoriteBrands : [];
        btn.textContent = list.indexOf(brandId) >= 0 ? '★ 已收藏于皇家档案' : '收藏至我的皇家档案';
      }
      sync();
      btn.addEventListener('click', function () {
        var p = getProf();
        var list = Array.isArray(p.favoriteBrands) ? p.favoriteBrands : [];
        if (list.indexOf(brandId) >= 0) {
          p.favoriteBrands = list.filter(function (x) { return x !== brandId; });
        } else {
          p.favoriteBrands = list.concat([brandId]);
        }
        try { localStorage.setItem(key, JSON.stringify(p)); } catch (e) {}
        sync();
      });
    })();
  </script>
</BaseLayout>
