---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="imp-gold" x1="8" y1="8" x2="56" y2="56" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#E8DDC8" />
      <stop offset="50%" stop-color="#C6A66A" />
      <stop offset="100%" stop-color="#8B7040" />
    </linearGradient>
    <linearGradient id="imp-navy" x1="16" y1="16" x2="48" y2="48" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1D3456" />
      <stop offset="100%" stop-color="#10141C" />
    </linearGradient>
  </defs>
  <!-- Orbital Ring -->
  <ellipse cx="32" cy="34" rx="26" ry="12" transform="rotate(-18 32 34)" stroke="url(#imp-gold)" stroke-width="2" opacity="0.85" />
  <!-- Geometric Diamond Shield -->
  <polygon points="32,8 50,26 32,56 14,26" fill="url(#imp-navy)" stroke="url(#imp-gold)" stroke-width="2.2" />
  <!-- Crown Silhouette -->
  <path d="M21 26L25 18L32 23L39 18L43 26H21Z" fill="url(#imp-gold)" />
  <!-- Inner Facet -->
  <path d="M32 28L41 34L32 47L23 34L32 28Z" stroke="#E8DDC8" stroke-width="1.3" fill="rgba(119,155,196,0.28)" />
  <circle cx="52" cy="20" r="2.5" fill="#C6A66A" />
</svg>
