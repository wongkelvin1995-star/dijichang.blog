---
interface Props {
  size?: number;
  label?: string;
}
const { size = 48, label = 'ORION · 铂金智核' } = Astro.props;
---
<div
  class="orion-sprite fx-orion"
  style={`width:${size}px;height:${size}px;border-radius:50%;overflow:hidden;border:1.5px solid #C6A66A;box-shadow:0 4px 14px rgba(20,36,60,0.28);flex-shrink:0;`}
  title={label}
>
  <img
    src="/images/characters/orion-core.jpg"
    alt={label}
    width={size}
    height={size}
    loading="eager"
    decoding="async"
    style="width:100%;height:100%;object-fit:cover;display:block;"
  />
</div>
