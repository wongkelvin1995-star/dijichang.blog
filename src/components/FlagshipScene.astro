---
import type { SceneId } from '../lib/types';

interface Props {
  scene: SceneId;
}

const { scene } = Astro.props;
---
<div class="scene-backdrop" aria-hidden="true">
  <svg width="100%" height="100%" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`sc-grad-${scene}`} x1="0" y1="0" x2="1440" y2="520" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#C6A66A" stop-opacity="0.16" />
        <stop offset="50%" stop-color="#779BC4" stop-opacity="0.12" />
        <stop offset="100%" stop-color="#14243C" stop-opacity="0.08" />
      </linearGradient>
    </defs>

    <!-- Soft Golden Light Drift -->
    <circle class="fx-golden-light" cx="1180" cy="120" r="260" fill={`url(#sc-grad-${scene})`} />

    {scene === 'headquarters' && (
      <g opacity="0.34">
        <!-- Platinum International HQ Towers & Glass Facade -->
        <path d="M900 520V120L1040 70V520H900Z" stroke="#C6A66A" stroke-width="1.4" fill="rgba(255,255,255,0.12)" />
        <path d="M1060 520V40L1220 95V520H1060Z" stroke="#779BC4" stroke-width="1.4" fill="rgba(201,210,223,0.12)" />
        <path d="M1240 520V160L1380 130V520H1240Z" stroke="#C6A66A" stroke-width="1.2" fill="rgba(232,221,200,0.1)" />
        <!-- Giant Transparent Digital Globe & Orbital Rings -->
        <circle cx="1120" cy="240" r="145" stroke="#779BC4" stroke-width="1.2" stroke-dasharray="5 5" />
        <ellipse class="fx-global-orbit" cx="1120" cy="240" rx="195" ry="52" transform="rotate(-16 1120 240)" stroke="#C6A66A" stroke-width="1.5" />
      </g>
    )}

    {scene === 'prestige' && (
      <g opacity="0.28">
        <!-- Prestige Hall Pillars & Metallic Award Geometry -->
        <rect x="80" y="60" width="24" height="420" stroke="#C6A66A" stroke-width="1.2" />
        <rect x="1336" y="60" width="24" height="420" stroke="#C6A66A" stroke-width="1.2" />
        <polygon points="1180,90 1290,200 1180,310 1070,200" stroke="#C6A66A" stroke-width="1.6" fill="rgba(198,166,106,0.08)" />
        <polygon points="1180,125 1255,200 1180,275 1105,200" stroke="#8B7040" stroke-width="1.2" />
      </g>
    )}

    {scene === 'backbone' && (
      <g opacity="0.32">
        <!-- Platinum Backbone Decorative Fiber Pulses (non-live decorative) -->
        <path class="fx-network-pulse" d="M0 140C360 80 720 240 1440 110" stroke="#779BC4" stroke-width="1.8" />
        <path class="fx-network-pulse" d="M0 320C420 240 940 390 1440 260" stroke="#C6A66A" stroke-width="1.6" />
        <circle cx="420" cy="148" r="6" fill="#779BC4" />
        <circle cx="980" cy="296" r="6" fill="#C6A66A" />
      </g>
    )}

    {scene === 'atlas' && (
      <g opacity="0.32">
        <!-- Global Atlas Giant Transparent Globe -->
        <circle cx="1160" cy="260" r="180" stroke="#779BC4" stroke-width="1.4" />
        <ellipse cx="1160" cy="260" rx="180" ry="62" stroke="#C6A66A" stroke-width="1.2" />
        <ellipse cx="1160" cy="260" rx="70" ry="180" stroke="#779BC4" stroke-width="1" />
        <ellipse class="fx-global-orbit" cx="1160" cy="260" rx="225" ry="68" transform="rotate(18 1160 260)" stroke="#C6A66A" stroke-width="1.3" />
      </g>
    )}

    {scene === 'velocity' && (
      <g opacity="0.26">
        <!-- Deep Blue Velocity Lab Grid -->
        <path d="M0 100H1440M0 220H1440M0 340H1440M0 460H1440" stroke="#779BC4" stroke-width="0.8" stroke-dasharray="4 8" />
        <path d="M240 0V520M600 0V520M960 0V520M1320 0V520" stroke="#779BC4" stroke-width="0.8" stroke-dasharray="4 8" />
      </g>
    )}

    {scene === 'nexus' && (
      <g opacity="0.3">
        <!-- Intelligence Nexus Core -->
        <circle cx="1220" cy="220" r="110" stroke="#C6A66A" stroke-width="1.4" />
        <circle cx="1220" cy="220" r="64" stroke="#779BC4" stroke-width="1.4" stroke-dasharray="6 4" />
        <polygon points="1220,140 1288,220 1220,300 1152,220" stroke="#E8DDC8" stroke-width="1.2" />
      </g>
    )}

    {scene === 'cinema' && (
      <g opacity="0.28">
        <!-- Platinum Cinema Ultrawide Frame -->
        <rect x="180" y="70" width="1080" height="380" rx="18" stroke="#C6A66A" stroke-width="1.2" />
        <rect x="220" y="100" width="1000" height="320" rx="12" stroke="#779BC4" stroke-width="1" stroke-dasharray="8 6" />
      </g>
    )}

    {scene === 'lounge' && (
      <g opacity="0.28">
        <!-- Executive Lounge Floor-to-Ceiling Skyline -->
        <line x1="0" y1="430" x2="1440" y2="430" stroke="#C6A66A" stroke-width="1.4" />
        <rect x="960" y="180" width="80" height="250" stroke="#779BC4" stroke-width="1" />
        <rect x="1060" y="130" width="95" height="300" stroke="#C6A66A" stroke-width="1" />
        <rect x="1180" y="210" width="75" height="220" stroke="#779BC4" stroke-width="1" />
      </g>
    )}

    {scene === 'collection' && (
      <g opacity="0.3">
        <!-- Prestige Collection Champagne Showcases -->
        <rect x="1020" y="90" width="280" height="340" rx="16" stroke="#C6A66A" stroke-width="1.4" />
        <line x1="1020" y1="200" x2="1300" y2="200" stroke="#C6A66A" stroke-width="1" />
        <line x1="1020" y1="315" x2="1300" y2="315" stroke="#C6A66A" stroke-width="1" />
      </g>
    )}

    {scene === 'archives' && (
      <g opacity="0.3">
        <!-- Imperial Archives Golden Bookshelves & Night Sky -->
        <rect x="100" y="60" width="220" height="400" stroke="#C6A66A" stroke-width="1.2" />
        <rect x="1120" y="60" width="220" height="400" stroke="#C6A66A" stroke-width="1.2" />
        <line x1="100" y1="160" x2="320" y2="160" stroke="#8B7040" stroke-width="1" />
        <line x1="100" y1="260" x2="320" y2="260" stroke="#8B7040" stroke-width="1" />
        <line x1="1120" y1="160" x2="1340" y2="160" stroke="#8B7040" stroke-width="1" />
        <line x1="1120" y1="260" x2="1340" y2="260" stroke="#8B7040" stroke-width="1" />
      </g>
    )}
  </svg>
</div>
